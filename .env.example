# Copy to .env and fill in. Never commit .env.
# API key from https://console.typesafe.ai/ (Jev is TypeSafe's model)
JEV_API_KEY=your-key-here

# Optional overrides (defaults shown)
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_S=30
# JEV_MAX_RETRIES=3

# Optional: your USD price per million tokens, to estimate cost.
# TypeSafe publishes no per-token rate for Jev, so there is no default.
# If Jev's response reports a cost itself, that is used instead.
# JEV_PRICE_INPUT_PER_MTOK=
# JEV_PRICE_OUTPUT_PER_MTOK=

# Tier 2 (OpenTelemetry Demo testbed). Defaults shown; usually no change needed.
# TIER2_BASE_URL=http://localhost:8080          # Envoy: frontend, /feature, /loadgen, /jaeger
# TIER2_PROMETHEUS_URL=http://localhost:9090
# TIER2_OPENSEARCH_URL=                         # default: asked from `docker port opensearch 9200`
# TIER2_PROFILE=full                            # or "minimal" (no Kafka, accounting, fraud-detection)

# Baseline LLM engines (run.py --engine claude-sonnet | claude-opus | ollama:<model>).
# Claude: set ANTHROPIC_API_KEY to use the Anthropic API. Without it, run.py falls back
# to the claude CLI (claude -p) and says so loudly; those runs are labelled claude-cli.
# ANTHROPIC_API_KEY=
# LLM_EFFORT=medium                             # low | medium | high | xhigh | max (both Claude models)
# OLLAMA_URL=http://localhost:11434
#
# Optional: USD per million tokens, to estimate Claude API cost. No defaults are built in.
# Anthropic list prices on 2026-10-05 (https://platform.claude.com/docs/en/about-claude/pricing):
# Sonnet 5.5 $2 in / $10 out, Opus 5.5 $4 in / $20 out. Check the page before relying on them.
# CLAUDE_SONNET_PRICE_INPUT_PER_MTOK=2
# CLAUDE_SONNET_PRICE_OUTPUT_PER_MTOK=10
# CLAUDE_OPUS_PRICE_INPUT_PER_MTOK=4
# CLAUDE_OPUS_PRICE_OUTPUT_PER_MTOK=20
